<?xml version="1.0" encoding="utf-8"?>
<!-- AndroidManifest.xml — Android app configuration
     This tells Android about your app: its name, permissions, entry point, etc. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- INTERNET permission: required to make HTTP calls to our backend API -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:label="Market"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <!-- Flutter needs this to handle deep links / initial route -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />

            <!-- This makes the app show up when you tap its icon -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Required for Flutter plugins that use background services -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
