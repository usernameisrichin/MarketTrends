<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Info.plist — iOS app configuration
     This tells iOS about your app: permissions, name, supported orientations, etc. -->
<plist version="1.0">
<dict>
	<!-- The main storyboard used at launch -->
	<key>UIMainStoryboardFile</key>
	<string>Main</string>

	<!-- App display name shown under the icon on the home screen -->
	<key>CFBundleDisplayName</key>
	<string>Market</string>

	<!-- App bundle identifier — must be unique on the App Store -->
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>

	<key>CFBundleName</key>
	<string>market_app</string>

	<key>CFBundlePackageType</key>
	<string>APPL</string>

	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>

	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>

	<!-- Supported device orientations -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- Required for Flutter rendering engine -->
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>

	<!-- Allow HTTP connections to localhost during development.
	     iOS blocks non-HTTPS by default. This exception is for dev only. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
